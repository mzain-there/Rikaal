# --- Vector DB ---
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=rikaal

# --- Embeddings (local, free) ---
EMBED_MODEL=all-MiniLM-L6-v2

# --- AWS Bedrock (only needed for /chat and /finalize) ---
AWS_REGION=us-east-1
# Model id: enable access in the Bedrock console first.
# Examples: anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Credentials: leave blank to use the EC2 instance role / aws configure.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

GITHUB_TOKEN=your_github_token_here
